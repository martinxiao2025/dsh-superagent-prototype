{
  "name": "dsh-superagent",
  "author": "dsh-superagent contributors",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "面向单个 GitHub 仓库的主动式编码代理：监听 GitHub 与可选的飞书，按 Policy 评估请求，把获授权的请求转成 Ticket，并在独立目录与 worker 会话中执行。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "README.md",
    "prompts",
    "skills",
    "plugin"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-plugin.mjs",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:check": "node scripts/validate-plugin.mjs && node scripts/validate-plugin.mjs --dir lib/plugin",
    "extension:check": "node --check extension/dsh-lm-bridge/extension.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm extension:check && pnpm test && pnpm build && pnpm plugin:check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "ajv": "8.20.0",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
